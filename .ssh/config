# SSH Configuration Template
# Copy this file to ~/.ssh/config and customize as needed

# Global SSH settings
Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes
    Compression yes

# Example host configuration
# Host example
#     HostName example.com
#     User yourusername
#     Port 22
#     IdentityFile ~/.ssh/example_key
#     ForwardAgent yes

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes

# Example: Personal server
# Host myserver
#     HostName 192.168.1.100
#     User username
#     Port 22
#     IdentityFile ~/.ssh/id_rsa
#     ForwardAgent yes

# Example: Jump host (bastion)
# Host bastion
#     HostName bastion.example.com
#     User username
#     IdentityFile ~/.ssh/bastion_key

# Example: Target through jump host
# Host internal-server
#     HostName 10.0.0.10
#     User username
#     ProxyJump bastion
#     IdentityFile ~/.ssh/internal_key

# Example: AWS EC2 instance
# Host aws-instance
#     HostName ec2-xx-xx-xx-xx.compute.amazonaws.com
#     User ec2-user
#     IdentityFile ~/.ssh/aws-key.pem

# Example: Multiple hosts with wildcard
# Host *.example.com
#     User username
#     IdentityFile ~/.ssh/example_key
#     ForwardAgent yes
