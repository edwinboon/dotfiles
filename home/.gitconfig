# Shared git defaults. Personal identity (name, email, signing key) lives in
# ~/.gitconfig.local (created by install.sh, not tracked in this repo).
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = default
[merge]
	conflictStyle = zdiff3
